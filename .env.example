# ==============================================================================
# SmartBlood - Root Environment Variables Example
# Duplicate this file as .env for local orchestration (never commit .env)
# ==============================================================================

# AWS Configuration (Local development mock / AWS CLI profile)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
STAGE=dev

# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_exampleId
COGNITO_CLIENT_ID=exampleclientid1234567890
COGNITO_IDENTITY_POOL_ID=us-east-1:00000000-0000-0000-0000-000000000000

# Amazon API Gateway
API_GATEWAY_URL=https://api-id.execute-api.us-east-1.amazonaws.com/dev

# Amazon DynamoDB
DYNAMODB_TABLE_SMARTBLOOD=SmartBlood-dev

# Amazon SNS
SNS_TOPIC_EMERGENCY_ALERTS_ARN=arn:aws:sns:us-east-1:123456789012:SmartBlood-EmergencyAlerts-dev

# Amazon S3 / CloudFront
FRONTEND_S3_BUCKET=smartblood-frontend-dev
CLOUDFRONT_DISTRIBUTION_ID=EXAMPLEID1234
CLOUDFRONT_DOMAIN=https://dxxxxxxxxxx.cloudfront.net

