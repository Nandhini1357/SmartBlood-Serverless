# ==============================================================================
# SmartBlood - Frontend Environment Variables Example
# Duplicate this file as frontend/.env for local development
# ==============================================================================

# API Gateway Endpoint
VITE_API_BASE_URL=https://api-id.execute-api.us-east-1.amazonaws.com/dev

# AWS Cognito Auth Configuration
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_exampleId
VITE_COGNITO_CLIENT_ID=exampleclientid1234567890

# Feature Toggles
VITE_MOCK_API_FALLBACK=true
VITE_ENABLE_MAP_VIEW=true

