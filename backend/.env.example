# ==============================================================================
# SmartBlood - Backend Service Environment Variables Example
# Duplicate this file as backend/.env for local invocation / testing
# ==============================================================================

NODE_ENV=development
AWS_REGION=us-east-1
STAGE=dev

# DynamoDB Configuration
DYNAMODB_TABLE=SmartBlood-dev

# SNS Notifications
SNS_EMERGENCY_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:SmartBlood-EmergencyAlerts-dev

# Cognito Auth Verification
COGNITO_USER_POOL_ID=us-east-1_exampleId
COGNITO_CLIENT_ID=exampleclientid1234567890

# Matching Configuration
DEFAULT_SEARCH_RADIUS_KM=25
MAX_SEARCH_RADIUS_KM=100
MAX_DONOR_MATCH_LIMIT=20

